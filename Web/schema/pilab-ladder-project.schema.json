          "id": "b_seal",
          "start": 0,
          "end": 1,
          "cells": [
            {
              "id": "no_run",
              "type": "NO",
              "tag": "Q0_Motor"
            },
            null,
            null,
            null,
            null,
            null,
            null,
            null
          ]
        }
      ]
    },
    "ladderRung": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "comment",
        "main",
        "branches"
      ],
      "description": "A visual ladder rung evaluated in scan order.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "ladder"
        },
        "comment": {
          "type": "string",
          "description": "Human-readable rung comment. May be empty."
        },
        "main": {
          "$ref": "#/$defs/slotArray8"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    },
    "scriptRung": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "comment",
        "code"
      ],
      "description": "Raw script rung emitted inside scan() for AngelScript export. The browser/Node JavaScript simulator supports a deterministic AngelScript-like subset.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "script"
        },
        "comment": {
          "type": "string",
          "description": "Human-readable rung comment. May be empty."
        },
        "code": {
          "type": "string",
          "description": "Script body emitted inside scan(). Tags referenced here are inferred by the simulator tag table; persistent values should be stored in tags, not local variables."
        }
      }
    },
    "rung": {
      "oneOf": [
        {
          "$ref": "#/$defs/ladderRung"
        },
        {
          "$ref": "#/$defs/scriptRung"
        }
      ]
    },
    "blockParam": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional metadata-aware writable parameter for TON/TOF PT or CTU/CTD PV. Used by AngelScript PiLabParam generation and HMI/live PLC bindings; ignored by the sandboxed JavaScript simulator.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, the ladder transpiler emits PiLabParam metadata and applies the generated parameter tag to the block."
        },
        "tag": {
          "$ref": "#/$defs/identifier",
          "description": "Writable PLC tag created for this parameter, for example T1_PT or C1_PV."
        },
        "min": {
          "type": "number",
          "description": "Minimum value accepted by the generated parameter tag."
        },
        "max": {
          "type": "number",
          "description": "Maximum value accepted by the generated parameter tag."
        },
        "default": {
          "type": "number",
          "description": "Optional explicit default value. If omitted, the symbol preset is used."
        },
        "units": {
          "type": "string",
          "description": "Optional display units, for example ms or count."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "tag"
            ]
          }
        }
      ]
    }
  },
  "examples": [
    {
      "schema": "pilab.ladder.project",
      "schema_version": 1,
      "name": "Minimal Motor Latch",
      "scan_ms": 5,
      "rungs": [
        {
          "id": "r_motor",
          "kind": "ladder",
          "comment": "Start/stop motor latch",
          "main": [
            {
              "id": "no_start",
              "type": "NO",
              "tag": "I0_Start"
            },
            null,
            {
              "id": "nc_stop",
              "type": "NC",
              "tag": "I1_Stop"
            },
            null,
            null,
            null,
            null,
            {
              "id": "out_motor",
              "type": "OUT",
              "tag": "Q0_Motor"
            }
          ],
          "branches": [
            {
              "id": "b_seal",
              "start": 0,
              "end": 1,
              "cells": [
                {
                  "id": "no_motor",
                  "type": "NO",
                  "tag": "Q0_Motor"
                },
                null,
                null,
                null,
                null,
                null,
                null,
                null
              ]
            }
          ]
        }
      ]
    }
  ],
  "x-ai-generation-rules": [
    "Generate exactly 8 main slots for each ladder rung.",
    "Generate exactly 8 cells for each branch.",
    "Use null for empty slots.",
    "Use branch start/end wire nodes, not pixel coordinates.",
    "Only place branch symbols in cells[start] through cells[end - 1].",
    "Use valid identifier tags matching ^[A-Za-z_][A-Za-z0-9_]*$.",
    "TON, TOF, CTU, and CTD require a positive preset.",
    "Prefer resetTag for CTU reset and CTD reload behavior.",
    "Do not use an NO/NC contact with the same tag as a TON, TOF, CTU, CTD, or ONS instance.",
    "To use a function-block done/output bit in ladder, place the block inline.",
    "To use function-block state in script, write T1.Q(), T1.ET(), or C1.CV().",
    "Keep simulator-oriented script rungs inside the documented JavaScript subset."
  ],
  "x-semantic-validation-notes": [
    "JSON Schema validates file shape, not all ladder meaning.",
    "The editor semantic validator should catch duplicate coils, duplicate function-block instances, symbols outside branch spans, suspicious empty branches, unsafe reset expressions, and outputless rungs.",
    "The schema intentionally permits additionalProperties for forward compatibility."
  ]
}
