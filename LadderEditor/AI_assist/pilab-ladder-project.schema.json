      ],
      "examples": [
        {
          "id": "b_seal",
          "start": 0,
          "end": 1,
          "cells": [
            {
              "id": "no_run",
              "type": "NO",
              "tag": "Q0_Motor"
            },
            null,
            null,
            null,
            null,
            null,
            null,
            null
          ]
        }
      ]
    },
    "ladderRung": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "comment",
        "main",
        "branches"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "ladder"
        },
        "comment": {
          "type": "string",
          "description": "Human-readable rung comment. May be empty."
        },
        "main": {
          "$ref": "#/$defs/slotArray8"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      },
      "examples": [
        {
          "id": "r1",
          "kind": "ladder",
          "comment": "Start/stop motor latch",
          "main": [
            {
              "id": "no_start",
              "type": "NO",
              "tag": "I0_Start"
            },
            null,
            {
              "id": "nc_stop",
              "type": "NC",
              "tag": "I1_Stop"
            },
            null,
            null,
            null,
            null,
            {
              "id": "out_motor",
              "type": "OUT",
              "tag": "Q0_Motor"
            }
          ],
          "branches": []
        }
      ]
    },
    "scriptRung": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "comment",
        "code"
      ],
      "description": "Raw script rung emitted inside scan() for AngelScript export. The browser/Node JavaScript simulator supports a practical deterministic subset of AngelScript-like statements.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "script"
        },
        "comment": {
          "type": "string",
          "description": "Human-readable rung comment. May be empty."
        },
        "code": {
          "type": "string",
          "description": "Script body emitted inside scan(). Tags referenced here are inferred by the simulator tag table; persistent values should be stored in tags, not local variables."
        }
      },
      "examples": [
        {
          "id": "s_scale",
          "kind": "script",
          "comment": "Scale and clamp analog value",
          "code": "float span = RawMax - RawMin;\nif (span > 0.0f) {\n    TankLevelPct = ((RawAI0 - RawMin) * 100.0f) / span;\n}\nTankLevelPct = max(0.0f, min(100.0f, TankLevelPct));"
        }
      ]
    },
    "rung": {
      "oneOf": [
        {
          "$ref": "#/$defs/ladderRung"
        },
        {
          "$ref": "#/$defs/scriptRung"
        }
      ]
    }
  },
  "examples": [
    {
      "schema": "pilab.ladder.project",
      "schema_version": 1,
      "name": "Minimal Motor Latch",
      "scan_ms": 5,
      "rungs": [
        {
          "id": "r_motor",
          "kind": "ladder",
          "comment": "Start/stop motor latch",
          "main": [
            {
              "id": "no_start",
              "type": "NO",
              "tag": "I0_Start"
            },
            null,
            {
              "id": "nc_stop",
              "type": "NC",
              "tag": "I1_Stop"
            },
            null,
            null,
            null,
            null,
            {
              "id": "out_motor",
              "type": "OUT",
              "tag": "Q0_Motor"
            }
          ],
          "branches": [
            {
              "id": "b_seal",
              "start": 0,
              "end": 1,
              "cells": [
                {
                  "id": "no_motor",
                  "type": "NO",
                  "tag": "Q0_Motor"
                },
                null,
                null,
                null,
                null,
                null,
                null,
                null
              ]
            }
          ]
        }
      ]
    }
